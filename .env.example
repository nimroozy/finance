# =============================================================================
# Collection System - Environment Template
# Copy to .env and fill in real values. Never commit .env.
# =============================================================================

APP_NAME="MNS Collection"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://finance.mns.af
APP_TIMEZONE=Asia/Kabul

FRONTEND_URL=https://finance.mns.af
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_APP_URL=https://finance.mns.af

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Database (Postgres is internal-only — never expose port 5432 publicly)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=collection
DB_USERNAME=collection
DB_PASSWORD=change-me-strong-db-password

# Redis (internal-only — never expose port 6379 publicly)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=change-me-strong-redis-password
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_DOMAIN=.finance.mns.af

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log

SANCTUM_STATEFUL_DOMAINS=finance.mns.af,www.finance.mns.af,209.38.194.184

# CORS
CORS_ALLOWED_ORIGINS=https://finance.mns.af,http://finance.mns.af,http://209.38.194.184

# Bootstrap admin (used only by app:install — change immediately after first login)
ADMIN_NAME="Super Administrator"
ADMIN_EMAIL=admin@finance.mns.af
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Company defaults
COMPANY_NAME="MNS Collection"
DEFAULT_CURRENCY=AFN

# Zoho Books (Stage 2 — leave empty for Stage 1)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=${APP_URL}/api/v1/zoho/callback
ZOHO_ORGANIZATION_ID=
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com

# WhatsApp Cloud API (Stage 6 — leave empty for Stage 1)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
