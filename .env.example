# =============================================================================
# Collection System - Environment Template
# Copy to .env and fill in real values. Never commit .env.
# =============================================================================

APP_NAME="MNS Collection"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://finance.mns.af
APP_TIMEZONE=Asia/Kabul

FRONTEND_URL=https://finance.mns.af
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_APP_URL=https://finance.mns.af

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Database (Postgres is internal-only — never expose port 5432 publicly)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=collection
DB_USERNAME=collection
DB_PASSWORD=change-me-strong-db-password

# Redis (internal-only — never expose port 6379 publicly)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=change-me-strong-redis-password
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_DOMAIN=.finance.mns.af

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log

# Leave empty when using Bearer token API (recommended). Cookie SPA CSRF is disabled.
SANCTUM_STATEFUL_DOMAINS=

# CORS (comma-separated). Also accepts FRONTEND_URL.
CORS_ALLOWED_ORIGINS=https://finance.mns.af

# Bootstrap admin (used only by app:install — change immediately after first login)
ADMIN_NAME="Super Administrator"
ADMIN_EMAIL=admin@finance.mns.af
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Company defaults
COMPANY_NAME="MNS Collection"
DEFAULT_CURRENCY=AFN

# Zoho Books OAuth / API (Stage 2 — never commit real secrets)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=https://finance.mns.af/api/v1/zoho/oauth/callback
ZOHO_ORGANIZATION_ID=
ZOHO_DATA_CENTER=us
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
# Optional sync intervals (minutes)
ZOHO_SYNC_CUSTOMERS_MINUTES=60
ZOHO_SYNC_INVOICES_MINUTES=60
ZOHO_TOKEN_REFRESH_MINUTES=30
ZOHO_RETRY_FAILED_MINUTES=15

# WhatsApp Cloud API (Stage 6 — leave empty)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
