APP_NAME="Finance Collection"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_DEFAULT_COUNTRY=AF
WHATSAPP_OUTGOING_PAUSED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (recommended for production)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=finance_collection
DB_USERNAME=postgres
DB_PASSWORD=

# Local sqlite alternative:
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Frontend / Sanctum SPA
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173

# Zoho Books OAuth / API (never commit real secrets)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI="${APP_URL}/api/v1/zoho/oauth/callback"
ZOHO_ORGANIZATION_ID=
ZOHO_DATA_CENTER=us
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
# ZOHO_OAUTH_SCOPES=ZohoBooks.fullaccess.all
# ZOHO_CUSTOMER_SYNC_MINUTES=60
# ZOHO_INVOICE_SYNC_MINUTES=60
# ZOHO_TOKEN_REFRESH_MINUTES=30
# ZOHO_RETRY_FAILED_MINUTES=15
ZOHO_PAYMENT_DRY_RUN=false

# Payments (Stage 4)
PAYMENT_DRAFT_EXPIRY_HOURS=24
PAYMENT_DEFAULT_CURRENCY=AFN
PAYMENT_WALLET_ENABLED=true

VITE_APP_NAME="${APP_NAME}"
