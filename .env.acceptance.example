# Stage 10.4 isolated acceptance environment — NEVER point at production DB.
# Copy to .env.acceptance and fill secrets. Used by docker-compose.acceptance.yml
# and ./scripts/run-acceptance.sh

COMPOSE_PROJECT_NAME=collection-acceptance
APP_NAME="MNS Collection Acceptance"
APP_ENV=acceptance
APP_DEBUG=true
APP_URL=http://127.0.0.1:18080
APP_KEY=
APP_STAGE=10.4-production-acceptance-closure
APP_BRANCH=cursor/stage-10-4-production-acceptance-closure
APP_COMMIT_SHA=
FRONTEND_BUILD_ID=
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_APP_URL=http://127.0.0.1:18080
NEXT_PUBLIC_APP_COMMIT_SHA=

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=collection_acceptance
DB_USERNAME=collection_acceptance
DB_PASSWORD=change-me-acceptance

REDIS_HOST=redis
REDIS_PASSWORD=change-me-acceptance-redis
REDIS_PORT=6379
REDIS_DB=2
CACHE_STORE=redis
CACHE_PREFIX=collection_acceptance
QUEUE_CONNECTION=redis
QUEUE_PREFIX=collection_acceptance
BROADCAST_CONNECTION=log
SESSION_DRIVER=redis
SESSION_CONNECTION=default

FILESYSTEM_DISK=local
ACCEPTANCE_STORAGE_ROOT=/var/www/html/storage/app/acceptance

WHATSAPP_SEND_ENABLED=false
RADIUS_ENABLED=false
E2E_ACCEPTANCE=1
ZOHO_WRITE_MODE=test_adapter

ACCEPTANCE_NGINX_HTTP_PORT=18080
ACCEPTANCE_FRONTEND_PORT=13000
ACCEPTANCE_BACKEND_PORT=18081

E2E_USER=ACCEPTANCE-admin
E2E_PASSWORD=AcceptancePass1!
BASE_URL=http://127.0.0.1:18080
PLAYWRIGHT_BASE_URL=http://127.0.0.1:18080
